# Normalize all text files to LF on checkout, regardless of the platform
# (Windows/macOS/Linux) or the committer's core.autocrlf setting.
* text=auto eol=lf

*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.sqlite binary
*.db binary
