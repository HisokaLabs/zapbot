# Copy this file to `.env` and adjust values as needed.
# Every variable is optional — unset/empty falls back to the default shown in config/*.js.
# `.env` is already git-ignored; never commit it.

# Comma-separated list of command prefixes, e.g. ".,!,#"
PREFIX=".,!,#"

# --- Session ---
# Logical session identifier forwarded to zapo's WaClient (alphanumeric + hyphens only).
SESSION_ID=default
# Where the SQLite auth/session store is persisted on disk.
SESSION_STORE_PATH=./.auth/state.sqlite
# zapo WA_BROWSERS value: chrome | chromium | firefox | safari | ie | opera | edge
SESSION_DEVICE_BROWSER=edge
# Operating system display name.
SESSION_OS_DISPLAY_NAME=Windows
# 'qr' renders a QR code in the terminal, 'code' requests an 8-char pairing code.
SESSION_PAIRING=qr
# Required when SESSION_PAIRING=code. Digits only, with country code. Keep this out of source control.
SESSION_PHONE_NUMBER=
SESSION_AUTO_RECONNECT=true
SESSION_MAX_RECONNECT_ATTEMPTS=10
# Whether to mark the account as online when connecting.
SESSION_MARK_ONLINE_ON_CONNECT=false

# --- Auto sticker ---
AUTO_STICKER_ENABLED=false
AUTO_STICKER_VIDEO_DURATION_LIMIT=10
AUTO_STICKER_PACKNAME=Bot Sticker
AUTO_STICKER_AUTHOR=Developer

# --- Bot Developer Number ---
# Comma-separated list of developer phone numbers (digits only, with country
# code). These JIDs are allowed to run `developer`-category commands such as
# `eval` and `exec`. The category is matched from each message's senderJid.
# Keep this out of source control.
BOT_DEVELOPER_NUMBER=

# --- Self bot ---
# When true, the bot only responds to its own account (self) or to
# BOT_DEVELOPER_NUMBER. Everyone else is silently ignored (no response at all).
SELF_BOT_ENABLED=false

# --- Pending command ---
# How long (ms) a pending command waits for the user's next message before expiring.
PENDING_COMMAND_TIMEOUT=60000

# --- Eval (developer `eval` plugin) ---
# safe | full
#   safe : isolated vm (worker), no Node host globals (process/require/fetch/...).
#   full : native eval in the bot process — full access to process globals and
#          the eval plugin's own module variables. NO isolation: process.exit()
#          kills the bot and an infinite loop freezes it. Use at your own risk.
EVAL_MODE=safe
# Hard timeout (ms) for a single evaluation.
EVAL_TIMEOUT=5000
# Cap (chars) on the returned output.
EVAL_MAX_OUTPUT=4000

# --- Exec sandbox (developer `exec` plugin) ---
# auto | docker | podman | host
#   auto   : probe docker, then podman, then fall back to UNSANDBOXED host execution.
#   docker : require docker, refuse to run if not installed.
#   podman : require podman, refuse to run if not installed.
#   host   : run directly on the host with no isolation (opt-in, risky).
EXEC_SANDBOX_MODE=auto
# Container image for docker/podman modes. Must include `bash` and `timeout`.
EXEC_SANDBOX_IMAGE=debian:bookworm-slim
# Hard timeout (ms) for a single command.
EXEC_TIMEOUT=15000
# Cap (chars) on the returned output.
EXEC_MAX_OUTPUT=4000
# Container resource limits.
EXEC_SANDBOX_MEMORY=256m
EXEC_SANDBOX_CPUS=0.5
EXEC_SANDBOX_PIDS_LIMIT=64
# When true, the container has network access (otherwise --network=none).
EXEC_SANDBOX_NETWORK=false
# When true, the container rootfs is read-only; writes only to a tmpfs /tmp.
EXEC_SANDBOX_READONLY=true
# UID:GID the command runs as inside the container. (Defaults to 65534:65534, the "nobody:nogroup" user.)
EXEC_SANDBOX_USER=65534:65534

# --- Plugins ---
PLUGINS_DIRECTORY=./src/plugins

# --- Logger ---
LOG_LEVEL=info
LOG_PRETTY=true
LOG_NAME=ZapBot
