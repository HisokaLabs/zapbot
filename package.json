{
   "name": "zapbot",
   "version": "1.0.0",
   "description": "WhatsApp bot built with Zapo.js",
   "type": "module",
   "main": "src/index.js",
   "engines": {
      "node": ">=20.9.0"
   },
   "scripts": {
      "start": "node src/index.js",
      "dev": "node --watch src/index.js",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "format": "prettier --write .",
      "format:check": "prettier --check ."
   },
   "imports": {
      "#types": "./types.js",
      "#config": "./config/config.js",
      "#core/*.js": "./src/core/*.js",
      "#events/*.js": "./src/events/*.js",
      "#plugins/*.js": "./src/plugins/*.js",
      "#utils/*.js": "./src/utils/*.js"
   },
   "keywords": [
      "whatsapp",
      "bot",
      "framework",
      "zapo",
      "plugin",
      "event-driven"
   ],
   "license": "MIT",
   "dependencies": {
      "@zapo-js/media-utils": "^1.0.0",
      "@zapo-js/store-sqlite": "^1.0.2",
      "@zapo-js/wam": "^0.1.1",
      "better-sqlite3": "^13.0.1",
      "dotenv": "^17.4.2",
      "moment-timezone": "^0.6.3",
      "pino": "^9.14.0",
      "pino-pretty": "^13.1.3",
      "qrcode-terminal": "^0.12.0",
      "wa-sticker-formatter": "^4.4.4",
      "zapo-js": "^1.6.1"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "eslint": "^10.7.0",
      "eslint-config-prettier": "^10.1.8",
      "eslint-import-resolver-node": "^0.4.0",
      "eslint-plugin-import-x": "^4.17.1",
      "eslint-plugin-prettier": "^5.5.6",
      "globals": "^17.7.0",
      "prettier": "^3.9.6"
   }
}
